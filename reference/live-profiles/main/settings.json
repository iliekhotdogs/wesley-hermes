{
  "model": {
    "default": "gpt-6.1-sol",
    "provider": "openai-codex"
  },
  "fallback_model": {
    "provider": "claude-subscription-directsdk-experimental",
    "model": "claude-sonnet-5"
  },
  "plugins": {
    "enabled": [
      "briefing-curation",
      "consistency-guards",
      "kanban-sandbox-guard",
      "profile-permissions",
      "second-brain-retrieval"
    ],
    "disabled": [
      "hermes-token-router"
    ]
  },
  "agent": {
    "max_turns": 150,
    "reasoning_effort": "high",
    "verify_on_stop": true,
    "disabled_toolsets": []
  },
  "approvals": {
    "mode": "off",
    "cron_mode": "approve",
    "single_query_mode": "approve",
    "unattended_mode": "approve",
    "destructive_slash_confirm": false
  },
  "delegation": {
    "max_concurrent_children": 1,
    "max_iterations": 50,
    "subagent_auto_approve": false
  },
  "memory": {
    "memory_enabled": true,
    "user_profile_enabled": false,
    "memory_char_limit": 2200,
    "user_char_limit": 1375
  },
  "terminal": {
    "backend": "local",
    "timeout": 180,
    "docker_mount_cwd_to_workspace": false
  },
  "kanban": {
    "dispatch_interval_seconds": 5,
    "max_in_progress": 2,
    "max_in_progress_per_profile": 1
  },
  "cron": {
    "model": "gpt-6-sol",
    "model_provider": "openai-codex",
    "max_parallel_jobs": 1
  },
  "compression": {
    "enabled": true,
    "threshold": 0.12,
    "target_ratio": 0.15,
    "protect_last_n": 20
  },
  "skills": {
    "disabled": [
      "youtube-content"
    ],
    "write_approval": false
  }
}
